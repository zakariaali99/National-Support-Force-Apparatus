# Copy to .env and fill in real values. .env is gitignored — never commit it.

# development | production
DJANGO_ENV=development

# --- Common ---
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# --- Development only ---
# Overrides the default local Postgres DSN in config/settings/development.py
# DATABASE_URL=postgres://nsfa:nsfa@localhost:5432/nsfa_dev

# --- Production only (all required — production.py raises if missing) ---
# DJANGO_DEBUG=False
# ALLOWED_HOSTS=nsfa.example.ly,www.nsfa.example.ly
# CORS_ALLOWED_ORIGINS=https://nsfa.example.ly
# POSTGRES_DB=nsfa
# POSTGRES_USER=nsfa
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# MEDIA_ROOT=/srv/nsfa/media
# PRIVATE_MEDIA_ROOT=/srv/nsfa/private_media
# DJANGO_SECURE_SSL_REDIRECT=True
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=
